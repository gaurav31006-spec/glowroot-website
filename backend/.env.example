# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/glowroot?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_random_jwt_key_here

# Single Admin Account Credentials
ADMIN_USERNAME=ishita
ADMIN_PASSWORD=YourSecureAdminPasswordHere!
ADMIN_EMAIL=ishita@glowroot.in

# Allowed Frontend URL for CORS (your live custom domain)
CLIENT_URL=https://glowroot.in
